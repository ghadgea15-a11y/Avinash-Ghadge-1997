        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["DRAFT", "SUBMITTED", "REVIEWED", "ACCEPTED"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "companyId", "logType", "siteId", "date", "status", "createdAt"]
    },
    "Announcement": {
      "title": "Announcement / Communication",
