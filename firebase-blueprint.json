      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "siteId": { "type": "string" },
        "planName": { "type": "string" },
        "frequency": { "type": "string", "enum": ["HOURLY", "DAILY", "PER_SHIFT", "CUSTOM_INTERVAL"] },
        "checkpointIds": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "companyId", "siteId", "planName", "frequency", "checkpointIds", "status", "createdAt"]
    },
    "PatrolTour": {
      "title": "Patrol Tour",
      "description": "Execution instance of guard patrol tour with checkpoint verifications and exception tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tourNumber": { "type": "string" },
        "companyId": { "type": "string" },
        "siteId": { "type": "string" },
        "assignedGuardId": { "type": "string" },
