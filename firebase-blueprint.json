        "startDate": { "type": "string" },
        "nextDueDate": { "type": "string" },
        "lastCompletedDate": { "type": "string" },
        "gracePeriod": { "type": "number" },
        "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
