  "firestore": {
    "/landing_page_config/{configId}": {
      "schema": { "$ref": "#/entities/LandingPageConfig" },
      "description": "Landing page published and draft configurations"
    },
    "/landing_page_versions/{versionId}": {
      "schema": { "$ref": "#/entities/LandingPageVersion" },
      "description": "Historical snapshots of published landing page configurations"
    },
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
