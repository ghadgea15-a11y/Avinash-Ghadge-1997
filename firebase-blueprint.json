        "city": { "type": "string" },
        "workforceSize": { "type": "string" },
        "interestedModules": { "type": "string" },
        "message": { "type": "string" },
        "utmSource": { "type": "string" },
        "source": { "type": "string" },
        "landingPage": { "type": "string" },
