        "cycleLabel": { "type": "string" },
        "totalEmployees": { "type": "number" },
        "totalNetPay": { "type": "number" },
        "status": { "type": "string", "enum": ["DRAFT", "PROCESSING", "CALCULATED", "PENDING_APPROVAL", "APPROVED", "LOCKED", "CANCELLED", "DISBURSED"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "companyId", "month", "year", "status", "createdAt"]
    },
    "PaymentBatch": {
      "title": "Bank Payment Batch",
      "description": "NEFT/RTGS payment batch disbursement records from locked payroll",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "batchNumber": { "type": "string" },
        "companyId": { "type": "string" },
        "payrollCycleId": { "type": "string" },
        "paymentMethod": { "type": "string", "enum": ["NEFT", "RTGS", "AUTO"] },
        "beneficiaryCount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["DRAFT", "VALIDATING", "VALIDATION_FAILED", "READY_FOR_APPROVAL", "APPROVED", "EXPORTED", "SUBMITTED", "COMPLETED", "FAILED", "CANCELLED"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "batchNumber", "companyId", "payrollCycleId", "paymentMethod", "totalAmount", "status", "createdAt"]
    },
