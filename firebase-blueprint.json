      "type": "object",
      "properties": {
        "breachId": { "type": "string" },
        "companyId": { "type": "string" },
        "clientId": { "type": "string" },
        "contractId": { "type": "string" },
        "siteId": { "type": "string" },
        "date": { "type": "string" },
        "shortfall": { "type": "number" },
        "penaltyAmount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["breachId", "companyId", "contractId", "siteId", "penaltyAmount", "status"]
