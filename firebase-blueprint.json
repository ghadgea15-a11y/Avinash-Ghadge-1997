        "updatedBy": { "type": "string" }
      },
      "required": ["id", "companyId", "title", "status", "createdAt", "updatedAt"]
    },
    "CompanyBankAccount": {
      "title": "Company Bank Account",
      "description": "Corporate disbursement bank accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "bankName": { "type": "string" },
