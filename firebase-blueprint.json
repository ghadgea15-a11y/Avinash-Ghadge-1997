        "expiresAt": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "companyId", "message", "priority", "createdAt"]
    },
    "VisitorLog": {
      "title": "Visitor Log",
      "description": "Gate entry/exit logs for visitors",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "siteId": { "type": "string" },
        "visitorName": { "type": "string" },
        "badgeNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["IN_SITE", "CHECKED_OUT"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "companyId", "siteId", "visitorName", "status", "createdAt"]
    },
    "MaterialMovement": {
      "title": "Material Movement Log",
      "description": "Inward/Outward material movement logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "siteId": { "type": "string" },
        "movementType": { "type": "string", "enum": ["INWARD", "OUTWARD"] },
        "gatePassNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING_APPROVAL", "APPROVED", "DISPATCHED", "RECEIVED", "REJECTED"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "companyId", "siteId", "movementType", "gatePassNumber", "status", "createdAt"]
    },
    "KpiSnapshot": {
      "title": "KPI Snapshot",
      "description": "Enterprise-wide health metrics for executive review",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "date": { "type": "string" },
        "totalActiveEmployees": { "type": "number" },
        "openIncidents": { "type": "number" },
        "totalSlaBreaches": { "type": "number" },
        "activeSites": { "type": "number" },
        "status": { "type": "string", "enum": ["PUBLISHED"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "companyId", "date", "status", "createdAt"]
    },
    "SalarySlip": {
      "title": "Salary Slip",
      "description": "Authoritative monthly employee payslip derived from locked payroll run",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "payrollCycleId": { "type": "string" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "netPay": { "type": "number" },
        "status": { "type": "string", "enum": ["GENERATED", "APPROVED", "PUBLISHED", "PAID"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "companyId", "payrollCycleId", "employeeId", "month", "year", "netPay", "status", "createdAt"]
    },
    "PayrollCycle": {
      "title": "Payroll Cycle",
      "description": "Monthly payroll execution and approval cycle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "month": { "type": "number" },
