        "contractNumber": { "type": "string" },
        "title": { "type": "string" },
        "siteIds": { "type": "array" },
        "billingCycle": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["contractId", "companyId", "clientId", "contractNumber", "status"]
    },
