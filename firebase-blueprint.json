        "completedCheckpointsCount": { "type": "number" },
        "completionPercentage": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "tourNumber", "companyId", "siteId", "assignedGuardId", "status", "totalCheckpoints", "createdAt"]
    },
