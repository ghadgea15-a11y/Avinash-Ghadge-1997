rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function claims() { return request.auth.token; }
    function isSignedIn() { return request.auth != null; }
    function isDeveloper() { return isSignedIn() && claims().isDeveloper == true; }
    function companyMatch(cid) { return isSignedIn() && claims().companyId == cid; }
    function hrTier() { return claims().role in ['companyOwner','admin','hr']; }
    function opsTier() { return claims().role in ['companyOwner','admin','hr','manager','incharge','supervisor']; }
    function validImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    function validDoc() {
      return request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png)');
    }

    match /companies/{cid}/{allPaths=**} {
      // Base company rule - deny by default to enforce granular privacy
    }

    match /companies/{cid}/employees/{eid}/{allPaths=**} {
      // General path for an employee - must be HR or self to read sensitive docs
      allow read: if companyMatch(cid) && (hrTier() || request.auth.uid == eid);
    }

    match /companies/{cid}/employees/{eid}/profile/{file} {
      // Allow others in company to read profile pics
      allow read: if companyMatch(cid);
      allow write: if companyMatch(cid) && (hrTier() || request.auth.uid == eid) && validImage();
    }
    match /companies/{cid}/employees/{eid}/documents/{docType}/{file} {
      allow read: if companyMatch(cid) && (hrTier() || request.auth.uid == eid);
      allow write: if companyMatch(cid) && hrTier() && validDoc();
    }
    match /companies/{cid}/employees/{eid}/selfie-verifications/{date}/{file} {
      allow write: if companyMatch(cid) && request.auth.uid == eid && validImage();
      allow delete: if false;
    }
    match /companies/{cid}/attendance/{branchId}/{month}/{aid}/{file} {
      allow read: if companyMatch(cid) && opsTier();
      allow write: if companyMatch(cid) && opsTier() && validImage();
    }
    match /companies/{cid}/sites/{sid}/qr-codes/{file} {
      allow read: if companyMatch(cid);
      allow write: if companyMatch(cid) && hrTier();
    }
    match /companies/{cid}/inventory/{iid}/images/{file} {
      allow read: if companyMatch(cid);
      allow write: if companyMatch(cid) && opsTier() && validImage();
    }
    match /companies/{cid}/gate_passes/{gpid}/{allPaths=**} {
      allow read: if companyMatch(cid);
      allow write: if companyMatch(cid) && validDoc();
    }
    match /companies/{cid}/assets/{allPaths=**} {
      allow read: if companyMatch(cid);
      allow write: if companyMatch(cid);
    }
    
    match /companies/{cid}/certifications/{allPaths=**} {
      allow read: if companyMatch(cid);
      allow write: if companyMatch(cid) && validDoc();
    }
    match /companies/{cid}/candidates/{candId}/{allPaths=**} {
      allow read: if companyMatch(cid) && (hrTier() || opsTier());
      allow write: if companyMatch(cid) && hrTier() && (validDoc() || validImage());
      allow delete: if companyMatch(cid) && hrTier();
    }
    match /companies/{cid}/serviceTickets/{tid}/{allPaths=**} {
      allow read: if companyMatch(cid);
      allow write: if companyMatch(cid) && validDoc();
      allow delete: if companyMatch(cid) && opsTier();
    }
    match /companies/{cid}/reports/exports/{uid}/{file} {
      allow read, write: if companyMatch(cid) && request.auth.uid == uid;
    }
    match /companies/{cid}/branding/{file} {
      allow read: if companyMatch(cid);
      allow write: if companyMatch(cid) && claims().role in ['companyOwner','admin'] && validImage();
    }
    match /system/backups/{cid}/{allPaths=**} {
      allow read, write: if isDeveloper();
    }
  }
}
