        allow update: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          isSelfEmployee(resource.data.reviewerEmployeeId)
        );
        allow delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
