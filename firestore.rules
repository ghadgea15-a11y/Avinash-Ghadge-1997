        allow update: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaff() || authorityLevel() == "A4_REGIONAL_AREA_MANAGER" || authorityLevel() == "A5_SITE_IN_CHARGE" || authorityLevel() == "A6_SUPERVISOR" || resource.data.toCustodianId == request.auth.uid);
