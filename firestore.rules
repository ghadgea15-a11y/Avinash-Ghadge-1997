      match /courseProgress/{progId} {
        allow read: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          isOfficialStaffDept("OPERATIONS") || 
          (authorityLevel() == "A4_REGIONAL_AREA_MANAGER" && (resource.data.regionId == regionId() || resource.data.regionId == null)) ||
          isSiteManager(resource.data.siteId, resource.data.departmentId) ||
          isSelfEmployee(resource.data.employeeId)
        );
        allow create, update: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          isOfficialStaffDept("OPERATIONS") || 
          authorityLevel() in ["A4_REGIONAL_AREA_MANAGER", "A5_SITE_IN_CHARGE", "A6_SUPERVISOR"] ||
          (isSelfEmployee(resource.data.employeeId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['antiCheatEvents', 'updatedAt', 'timeSpentSeconds', 'quizAnswers']))
        );
        allow delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
      }

      // Subcollection for quizAttempts & certificates
      match /quizAttempts/{attemptId} {
        allow read: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          isSiteManager(resource.data.siteId, resource.data.departmentId) || 
          isSelfEmployee(resource.data.employeeId)
        );
        allow create: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR") || isSelfEmployee(request.resource.data.employeeId));
        allow update, delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
      }

      match /certificates/{certId} {
        allow read: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          isSiteManager(resource.data.siteId, resource.data.departmentId) || 
          isSelfEmployee(resource.data.employeeId)
        );
        allow create, update, delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
      }

      match /refresher_configs/{configId} {
        allow read: if sameCompany(cId);
        allow create, update, delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR") || isOfficialStaffDept("OPERATIONS"));
      }

      match /mandatoryRefreshers/{refId} {
        allow read: if sameCompany(cId);
        allow create, update: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          isOfficialStaffDept("OPERATIONS") || 
          authorityLevel() in ["A4_REGIONAL_AREA_MANAGER", "A5_SITE_IN_CHARGE", "A6_SUPERVISOR"]
        );
        allow delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
      }

      // ----------------------------------------------------------
      // Subcollection: Module 26 Enterprise Integration Layer
      // ----------------------------------------------------------
      match /apiKeys/{keyId} {
        // Enforce: only hashed keys stored, only IT/Admin roles can read/write
        allow read: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("IT") || isSuperAdmin());
        allow create, update: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("IT") || isSuperAdmin()) &&
          (!('rawKey' in request.resource.data) || request.resource.data.rawKey == null) &&
          ('keyHash' in request.resource.data || 'hashedKey' in request.resource.data);
        allow delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("IT") || isSuperAdmin());
      }

      match /webhookSubscriptions/{subId} {
        // Enforce: Webhook secrets readable only by IT/Admin roles
        allow read, write: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("IT") || isSuperAdmin());
      }

      match /webhookDeliveries/{delId} {
        allow read: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("IT") || isSuperAdmin());
        allow write: if false; // Server-side append only
      }

      match /ssoConfigs/{configId} {
        allow read, write: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("IT") || isSuperAdmin());
      }

      match /integrationConnectors/{connId} {
        allow read, write: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("IT") || isOfficialStaffDept("FINANCE") || isSuperAdmin());
      }

      // ----------------------------------------------------------
      // Subcollection: Module 27 Expense & Travel Management
      // ----------------------------------------------------------
      match /expenseClaims/{claimId} {
        allow read: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("FINANCE") || 
          isOfficialStaffDept("HR") || 
          isSiteManager(resource.data.siteId, resource.data.departmentId) || 
          isSelfEmployee(resource.data.employeeId)
        );
        allow create: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("FINANCE") || 
          isSelfEmployee(request.resource.data.employeeId) ||
          authorityLevel() in ["A4_REGIONAL_AREA_MANAGER", "A5_SITE_IN_CHARGE", "A6_SUPERVISOR"]
        );
        // Immutability: Once APPROVED/DISBURSED, non-finance roles CANNOT modify
        allow update: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("FINANCE") || 
          (
            isSelfEmployee(resource.data.employeeId) && 
            resource.data.status == "DRAFT" && 
            request.resource.data.status in ["DRAFT", "SUBMITTED"]
          ) ||
          (
            isSiteManager(resource.data.siteId, resource.data.departmentId) && 
            resource.data.status in ["SUBMITTED", "UNDER_REVIEW"] && 
            request.resource.data.siteId == resource.data.siteId
          )
        );
        allow delete: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          (isSelfEmployee(resource.data.employeeId) && resource.data.status == "DRAFT")
        );
      }

      match /travelRequests/{reqId} {
        allow read: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("FINANCE") || 
          isOfficialStaffDept("HR") || 
          isSelfEmployee(resource.data.employeeId) ||
          authorityLevel() in ["A4_REGIONAL_AREA_MANAGER", "A5_SITE_IN_CHARGE"]
        );
        allow create, update: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("FINANCE") || 
          isSelfEmployee(request.resource.data.employeeId) ||
          authorityLevel() in ["A4_REGIONAL_AREA_MANAGER", "A5_SITE_IN_CHARGE"]
        );
        allow delete: if sameCompany(cId) && (isOwnerOrExecutive() || isSelfEmployee(resource.data.employeeId));
      }

      match /expensePolicies/{policyId} {
        allow read: if sameCompany(cId);
        allow create, update, delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("FINANCE"));
      }

      // ----------------------------------------------------------
      // Phase A-D: Complete Enterprise Talent Management Suite
      // ----------------------------------------------------------
      // 1. Competency Skills, Skills Matrix & Succession Planning
      match /competencySkills/{skillId} {
        allow read: if sameCompany(cId);
        allow create, update, delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
      }

      match /skillsMatrix/{matrixId} {
        allow read: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          isOfficialStaffDept("OPERATIONS") || 
          isSiteManager(resource.data.siteId, resource.data.departmentId) || 
          isSelfEmployee(resource.data.employeeId)
        );
        allow create, update: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          authorityLevel() in ["A4_REGIONAL_AREA_MANAGER", "A5_SITE_IN_CHARGE"]
        );
        allow delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
      }

      match /successionPlans/{planId} {
        allow read, write: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR") || authorityLevel() == "A4_REGIONAL_AREA_MANAGER");
      }

      match /careerTracks/{trackId} {
        allow read: if sameCompany(cId);
        allow create, update, delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
      }

      // 2. Offer Letters & Day-1 Onboarding
      match /offerLetters/{offerId} {
        allow read: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          isOfficialStaffDept("FINANCE") || 
          isSiteManager(resource.data.siteId, resource.data.departmentId)
        );
        allow create, update: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
        allow delete: if sameCompany(cId) && isOwnerOrExecutive();
      }

      match /onboardingChecklists/{onbId} {
        allow read: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          isOfficialStaffDept("OPERATIONS") || 
          isSiteManager(resource.data.siteId, resource.data.departmentId)
        );
        allow create, update: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          authorityLevel() in ["A4_REGIONAL_AREA_MANAGER", "A5_SITE_IN_CHARGE", "A6_SUPERVISOR"]
        );
        allow delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
      }

      // 3. Master Training Calendar & Kirkpatrick Evaluations
      match /trainingCalendar/{eventId} {
        allow read: if sameCompany(cId);
        allow create, update, delete: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          isOfficialStaffDept("OPERATIONS") || 
          authorityLevel() in ["A4_REGIONAL_AREA_MANAGER", "A5_SITE_IN_CHARGE"]
        );
      }

      match /trainingEvaluations/{evalId} {
        allow read: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          isSiteManager(resource.data.siteId, resource.data.departmentId) || 
          isSelfEmployee(resource.data.employeeId)
        );
        allow create, update: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          authorityLevel() in ["A4_REGIONAL_AREA_MANAGER", "A5_SITE_IN_CHARGE", "A6_SUPERVISOR"] ||
          isSelfEmployee(resource.data.employeeId)
        );
        allow delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
      }

      // 4. Rewards, Recognition & Points Wallets
      match /rewardNominations/{nominationId} {
        allow read: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaff() || 
          isSiteManager(resource.data.nomineeSiteId, resource.data.nomineeDepartment) || 
          isSelfEmployee(resource.data.nomineeEmployeeId) || 
          isSelfEmployee(resource.data.nominatedByEmployeeId)
        );
        allow create: if sameCompany(cId) && signedIn();
        allow update: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR") || isOfficialStaffDept("FINANCE"));
        allow delete: if sameCompany(cId) && isOwnerOrExecutive();
      }

      match /recognitionBadges/{badgeId} {
        allow read: if sameCompany(cId);
        allow create: if sameCompany(cId) && signedIn();
        allow update, delete: if sameCompany(cId) && isOwnerOrExecutive();
      }

      match /rewardWallets/{walletId} {
        allow read: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          isOfficialStaffDept("FINANCE") || 
          isSelfEmployee(resource.data.employeeId)
        );
        allow create, update: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR") || isOfficialStaffDept("FINANCE"));
        allow delete: if sameCompany(cId) && isOwnerOrExecutive();
      }
    }



    // ============================================================
    // 5. DYNAMIC COMPANY ATTENDANCE COLLECTIONS
    // (e.g., /attendance_MUSTER-CORP-101)
    // ============================================================

    match /{collectionId}/{attendanceId} {
      function isAttendanceCollection() {
        return collectionId.startsWith("attendance_");
      }

      function getCompanyCodeFromCollection() {
        return collectionId.split("attendance_")[1];
      }

      allow read: if isAttendanceCollection() && (
        isSuperAdmin() || (sameCompany(getCompanyCodeFromCollection()) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          isOfficialStaffDept("FINANCE") || 
          isOfficialStaffDept("OPERATIONS") || 
          (authorityLevel() == "A4_REGIONAL_AREA_MANAGER" && (resource.data.assignedRegionId == regionId() || resource.data.assignedRegionId == null)) || 
          isSiteManager(resource.data.siteId, resource.data.departmentId) || 
          isSelfEmployee(resource.data.employeeId)
        ))
      );

      allow create: if isAttendanceCollection() && (
        isSuperAdmin() || (sameCompany(getCompanyCodeFromCollection()) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          isOfficialStaffDept("OPERATIONS") || 
          (authorityLevel() in ["A5_SITE_IN_CHARGE", "A6_SUPERVISOR"] && request.resource.data.siteId == siteId() && !isSelfEmployee(request.resource.data.employeeId)) || 
          isSelfEmployee(request.resource.data.employeeId)
        ))
      );

      allow update: if isAttendanceCollection() && (
        isSuperAdmin() || (sameCompany(getCompanyCodeFromCollection()) && (isOwnerOrExecutive() || isOfficialStaff() || isSiteManager(resource.data.siteId, resource.data.departmentId)))
      );

      allow delete: if isAttendanceCollection() && (
        isSuperAdmin() || (sameCompany(getCompanyCodeFromCollection()) && isOwnerOrExecutive())
      );
    }
    // ============================================================
    // 6. COLLECTION GROUP QUERIES (Mandatory for cross-tenant/subcollection searches)
    // ============================================================
    match /collectionGroup/{groupName}/{documentId} {
      allow read: if (groupName == 'predictions' || groupName == 'incident_reports') 
                  && signedIn() 
                  && sameCompany(resource.data.companyId)
                  && (
                    isSuperAdmin() || 
                    isOwnerOrExecutive() || 
                    isOfficialStaff() || 
                    (authorityLevel() == "A4_REGIONAL_AREA_MANAGER" && resource.data.assignedRegionId == regionId()) ||
                    isSiteManager(resource.data.siteId, resource.data.departmentId) ||
                    isSelfEmployee(resource.data.reportedById)
                  );
    }
  }
}
