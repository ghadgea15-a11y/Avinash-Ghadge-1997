      // Strictly Append-Only / Immutable Physical Movement & Audit Trail
      match /asset_movements/{movementId} {
        allow read: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaff() || authorityLevel() == "A4_REGIONAL_AREA_MANAGER" || authorityLevel() == "A5_SITE_IN_CHARGE" || authorityLevel() == "A6_SUPERVISOR" || resource.data.performedByUid == request.auth.uid || resource.data.employeeId == request.auth.token.employeeId);
        allow create: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaff() || authorityLevel() == "A4_REGIONAL_AREA_MANAGER" || authorityLevel() == "A5_SITE_IN_CHARGE" || authorityLevel() == "A6_SUPERVISOR");
        allow update, delete: if false; // STRICT IMMUTABLE AUDIT TRAIL - NO EDITS OR DELETIONS PERMITTED
      }

      // EAM Asset Transfers (State-Machine Workflow with Immutable History)
      match /asset_transfers/{transferId} {
        allow read: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaff() || authorityLevel() == "A4_REGIONAL_AREA_MANAGER" || authorityLevel() == "A5_SITE_IN_CHARGE" || authorityLevel() == "A6_SUPERVISOR" || resource.data.requestedBy == request.auth.uid || resource.data.toCustodianId == request.auth.uid || resource.data.fromCustodianId == request.auth.uid);
