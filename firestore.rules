      // EAM Maintenance & Repair Logs
      match /asset_maintenance/{maintenanceId} {
        allow read: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaff() || authorityLevel() == "A4_REGIONAL_AREA_MANAGER" || authorityLevel() == "A5_SITE_IN_CHARGE" || authorityLevel() == "A6_SUPERVISOR");
        allow create, update: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaff() || authorityLevel() == "A4_REGIONAL_AREA_MANAGER" || authorityLevel() == "A5_SITE_IN_CHARGE" || authorityLevel() == "A6_SUPERVISOR");
