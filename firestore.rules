        allow create: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaff() || isSiteManager(request.resource.data.siteId, request.resource.data.departmentId) || request.resource.data.createdBy == request.auth.uid);
        allow update: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaff() || (isSiteManager(resource.data.siteId, resource.data.departmentId) && request.resource.data.siteId == resource.data.siteId) || resource.data.assignedTo == request.auth.uid || resource.data.createdBy == request.auth.uid);
        allow delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaff());
