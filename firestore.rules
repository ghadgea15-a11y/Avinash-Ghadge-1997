rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // 1. DEFAULT: STRICT LEAST PRIVILEGE DOMAIN SEPARATION
    // ============================================================
    // Explicit security boundary: Platform Control Plane !== Tenant Control Plane

    // ============================================================
    // 2. TRUSTED FIREBASE AUTH CUSTOM CLAIM HELPERS
    // ============================================================

    function signedIn() {
      return request.auth != null && request.auth.token != null;
    }

    function companyId() {
      return request.auth.token.cId != null 
        ? request.auth.token.cId 
        : (request.auth.token.companyId != null 
            ? request.auth.token.companyId 
            : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId);
    }

    function authorityLevel() {
      return request.auth.token.aLvl != null 
        ? request.auth.token.aLvl 
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.authorityLevel;
    }

    function role() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function regionId() {
      return request.auth.token.rId != null ? request.auth.token.rId : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.regionId;
    }

    function siteId() {
      return request.auth.token.sId != null ? request.auth.token.sId : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedSiteId;
    }

    function departmentId() {
      return request.auth.token.dId != null ? request.auth.token.dId : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.departmentId;
    }

    function permissionsVersion() {
      return request.auth.token.pV != null ? request.auth.token.pV : 1;
    }

    function isTerminatedOrSuspended() {
      return request.auth.token.status == "TERMINATED" || request.auth.token.status == "SUSPENDED" || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus in ["TERMINATED", "SUSPENDED"];
    }

    function isActiveUser() {
      return signedIn() 
        && !isTerminatedOrSuspended() 
        && companyId() != null 
        && authorityLevel() != null;
    }

    function sameCompany(cId) {
      return isActiveUser() && companyId() == cId;
    }

    // Platform Super Admin is an isolated platform identity (NOT an A0-A9 tenant role)
    function isSuperAdmin() {
      return signedIn() && (
        request.auth.token.email_verified == true && (
          request.auth.token.isPlatformAdmin == true || 
          request.auth.token.role == "SUPER_ADMIN" || 
          request.auth.token.platformRole == "SUPER_ADMIN" ||
          request.auth.token.authorityLevel == "SUPER_ADMIN" ||
          exists(/databases/$(database)/documents/super_admins/$(request.auth.uid))
        )
      );
    }

    function hasActiveSupportSession(cId) {
      return isSuperAdmin() && request.auth.token.supportCompanyId == cId;
    }

    function isOwnerOrExecutive() {
      return isActiveUser() && authorityLevel() in ["A0_OWNER", "A1_DIRECTOR_CEO", "A2_GENERAL_MANAGER"];
    }

    function isOfficialStaff() {
      return isActiveUser() && authorityLevel() == "A3_OFFICIAL_STAFF";
    }

    function isOfficialStaffDept(dept) {
      return isOfficialStaff() && departmentId() == dept;
    }

    function isRegionalManager(rId) {
      return isActiveUser() && authorityLevel() == "A4_REGIONAL_AREA_MANAGER" && regionId() == rId;
    }

    function isSiteManager(sId, deptId) {
      return isActiveUser() && siteId() == sId && (
        authorityLevel() == "A5_SITE_IN_CHARGE" ||
        (authorityLevel() == "A6_SUPERVISOR" && departmentId() == deptId)
      );
    }

    function isGroundWorker() {
      return isActiveUser() && authorityLevel() in ["A7_SKILLED", "A8_SEMI_SKILLED", "A9_SUPPORT"];
    }

    function isSelfEmployee(empId) {
      return signedIn() && request.auth.token.employeeId == empId;
    }

    function isSelfUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ============================================================
    // 2.1 EXTERNAL CLIENT PORTAL USER (OUTSIDE A0-A9 HIERARCHY)
    // ============================================================
    function isClientUser() {
      return signedIn() && 
        request.auth.token.role == "clientUser" &&
        request.auth.token.cId != null &&
        request.auth.token.clientId != null;
    }

    function isClientUserForCompany(cId) {
      return isClientUser() && request.auth.token.cId == cId;
    }

    function clientHasSiteAccess(sId) {
      return isClientUser() && (
        request.auth.token.siteIds != null && 
        (sId in request.auth.token.siteIds)
      );
    }


    // ============================================================
    // 3. GLOBAL ROOT LEVEL COLLECTIONS
    // ============================================================

    // A. User Profiles & Tenant Memberships
    match /totp_secrets/{docId} {
      allow read, write: if isSelfUser(docId) || isSuperAdmin();
    }

    match /users/{uid}/private/mfa {
      allow read, write: if isSelfUser(uid) || isSuperAdmin();
    }

    match /users/{uid}/private/{docId} {
      allow read, write: if isSelfUser(uid) || isSuperAdmin();
    }
    
    match /users/{uid} {
      allow read: if signedIn() && (
        isSuperAdmin() || 
        isSelfUser(uid) || 
        (isActiveUser() && companyId() == resource.data.companyId)
      );

      // Self-registration cannot inject arbitrary companyId or administrative authorityLevels
      allow create: if signedIn() && (
        isSuperAdmin() || 
        (
          isSelfUser(uid) && 
          (!('authorityLevel' in request.resource.data) || request.resource.data.authorityLevel in ["A7_SKILLED", "A8_SEMI_SKILLED", "A9_SUPPORT"]) &&
          (!('isPlatformAdmin' in request.resource.data) || request.resource.data.isPlatformAdmin != true) &&
          (!('role' in request.resource.data) || request.resource.data.role != "SUPER_ADMIN")
        )
      );

      // Prevent users from tampering with their own companyId, role, or authorityLevel via REST/client calls
      allow update: if signedIn() && (
        isSuperAdmin() || 
        (
          isSelfUser(uid) && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'companyId', 'authorityLevel', 'role', 'accountStatus', 
            'isPlatformAdmin', 'platformRole', 'assignedSiteId', 
            'assignedRegionId', 'departmentId', 'employeeId'
          ])
        ) || 
        (isActiveUser() && isOwnerOrExecutive() && companyId() == resource.data.companyId)
      );

      allow delete: if isSuperAdmin();

      match /memberships/{cId} {
        allow read, write: if isSelfUser(uid) || isSuperAdmin();
      }
    }

    // B. Company Codes (Unauthenticated Lookup for Login Screen Discovery)
    match /company_codes/{codeId} {
      allow get: if true; // Unauthenticated GET allowed to verify company code on login screen
      allow list: if isSuperAdmin(); // Public LIST forbidden to prevent tenant harvesting
      allow write: if isSuperAdmin();
    }

    match /companyCodes/{codeId} {
      allow get: if true; // Unauthenticated GET allowed for legacy company code lookup
      allow list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // C. System Dictionaries & Configurations
    match /publicJobPostings/{postingId} {
      allow read: if true; // Fully public, unauthenticated read-only for external job seekers
      allow write: if false; // Admin SDK / Backend Cloud Functions only (zero client-side writes)
    }

    match /plans/{planId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /modules/{moduleId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /userRoles/{roleId} {
      allow read, write: if isSuperAdmin();
    }

    // D. Global Infrastructure Mappings (Scoped strictly to tenant companyId)
    match /regions/{regionId} {
      allow read: if isActiveUser() && (isSuperAdmin() || resource.data.companyId == companyId());
      allow write: if isSuperAdmin() || (isActiveUser() && isOwnerOrExecutive() && (resource == null || resource.data.companyId == companyId()) && request.resource.data.companyId == companyId());
    }

    match /branches/{branchId} {
      allow read: if isActiveUser() && (isSuperAdmin() || resource.data.companyId == companyId());
      allow write: if isSuperAdmin() || (isActiveUser() && isOwnerOrExecutive() && (resource == null || resource.data.companyId == companyId()) && request.resource.data.companyId == companyId());
    }

    match /sites/{siteId} {
      allow read: if isActiveUser() && (isSuperAdmin() || resource.data.companyId == companyId());
      allow write: if isSuperAdmin() || (isActiveUser() && isOwnerOrExecutive() && (resource == null || resource.data.companyId == companyId()) && request.resource.data.companyId == companyId());
    }

    match /departments/{departmentId} {
      allow read: if isActiveUser() && (isSuperAdmin() || resource.data.companyId == companyId());
      allow write: if isSuperAdmin() || (isActiveUser() && isOwnerOrExecutive() && (resource == null || resource.data.companyId == companyId()) && request.resource.data.companyId == companyId());
    }

    match /designations/{designationId} {
      allow read: if isActiveUser() && (isSuperAdmin() || resource.data.companyId == companyId());
      allow write: if isSuperAdmin() || (isActiveUser() && isOwnerOrExecutive() && (resource == null || resource.data.companyId == companyId()) && request.resource.data.companyId == companyId());
    }

    match /shifts/{shiftId} {
      allow read: if isActiveUser() && (isSuperAdmin() || resource.data.companyId == companyId());
      allow write: if isSuperAdmin() || (isActiveUser() && isOwnerOrExecutive() && (resource == null || resource.data.companyId == companyId()) && request.resource.data.companyId == companyId());
    }

    // E. Global Approval Requests & Applications
    match /approval_requests/{requestId} {
      allow read: if signedIn() && (
        isSuperAdmin() ||
        resource == null ||
        resource.data.uid == request.auth.uid ||
        (isActiveUser() && companyId() == resource.data.companyId && (isOwnerOrExecutive() || isOfficialStaff()))
      );
      allow create: if signedIn();
      allow update: if isSuperAdmin() || (isActiveUser() && companyId() == resource.data.companyId && (isOwnerOrExecutive() || isOfficialStaff()));
      allow delete: if isSuperAdmin();
    }

    // F. Global Audit Trails & System Notifications
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin() || (isActiveUser() && isOwnerOrExecutive() && resource.data.companyId == companyId());
      allow create: if signedIn();
      allow update, delete: if false; // STRICT IMMUTABLE AUDIT TRAIL - WRITE-ONCE ONLY
    }

    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || (isActiveUser() && isOwnerOrExecutive() && resource.data.companyId == companyId());
      allow create: if signedIn();
      allow update, delete: if false; // STRICT IMMUTABLE AUDIT TRAIL - WRITE-ONCE ONLY
    }

    match /super_admins/{uid} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /platform_audit_logs/{auditId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false; // Immutable ledger: updates and deletions strictly forbidden
    }

    match /platform_security_events/{eventId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /support_sessions/{sessionId} {
      allow read, write: if isSuperAdmin() || signedIn();
    }

    match /platform_monitoring/{docId} {
      allow read, write: if isSuperAdmin() || signedIn();
    }

    match /platform_config/{configId} {
      allow get: if true; // Public get so login screens can check maintenance mode
      allow list, write: if isSuperAdmin() || signedIn();
    }

    match /system_config/{configId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /leads/{leadId} {
      allow create: if true; // Allow landing page visitors to submit demo/inquiry requests
      allow read, update, delete: if isSuperAdmin() || signedIn();
    }

    match /demo_requests/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin() || signedIn();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (isSuperAdmin() || resource.data.recipientId == request.auth.uid || resource.data.recipientUid == request.auth.uid || (resource.data.companyId == companyId() && (isOwnerOrExecutive() || isOfficialStaff())));
      allow create: if isSuperAdmin() || (isActiveUser() && (isOwnerOrExecutive() || isOfficialStaff() || authorityLevel() in ["A4_REGIONAL_AREA_MANAGER", "A5_SITE_IN_CHARGE", "A6_SUPERVISOR"]));
      allow update, delete: if isSuperAdmin() || (isActiveUser() && isOwnerOrExecutive());
    }

    match /employeeCertifications/{certId} {
      allow read: if signedIn() && (
        isSuperAdmin() || 
        (isActiveUser() && resource.data.companyId == companyId() && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          isOfficialStaffDept("OPERATIONS") || 
          authorityLevel() in ["A4_REGIONAL_AREA_MANAGER", "A5_SITE_IN_CHARGE", "A6_SUPERVISOR"] ||
          isSelfEmployee(resource.data.employeeId)
        ))
      );
      allow create, update: if signedIn() && (
        isSuperAdmin() || 
        (isActiveUser() && request.resource.data.companyId == companyId() && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          isOfficialStaffDept("OPERATIONS") || 
          authorityLevel() in ["A4_REGIONAL_AREA_MANAGER", "A5_SITE_IN_CHARGE", "A6_SUPERVISOR"]
        ))
      );
      allow delete: if signedIn() && (
        isSuperAdmin() || 
        (isActiveUser() && resource.data.companyId == companyId() && (isOwnerOrExecutive() || isOfficialStaffDept("HR")))
      );
    }


    // ============================================================
    // 4. HIERARCHICAL MULTI-TENANT COMPANY COLLECTIONS
    // ============================================================

    match /companies/{cId} {
      // Unauthenticated GET allowed to fetch basic company metadata for tenant validation
      allow get: if true;
      allow list: if isSuperAdmin() || sameCompany(cId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (sameCompany(cId) && isOwnerOrExecutive());
      allow delete: if isSuperAdmin();

      // ----------------------------------------------------------
      // Subcollection: Subscriptions, Entitlements & Billing
      // ----------------------------------------------------------
      match /subscriptions/{subId} {
        allow read: if isSuperAdmin() || sameCompany(cId);
        allow write: if isSuperAdmin();
      }

      match /entitlements/{moduleId} {
        allow read: if isSuperAdmin() || sameCompany(cId);
        allow write: if isSuperAdmin();
      }

      match /payments/{paymentId} {
        allow read: if isSuperAdmin() || (sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("FINANCE")));
        allow write: if isSuperAdmin();
      }

      match /invoices/{invoiceId} {
        allow read: if isSuperAdmin() || (sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("FINANCE")));
        allow write: if isSuperAdmin();
      }

      match /subscriptionHistory/{historyId} {
        allow read: if isSuperAdmin() || (sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("FINANCE")));
        allow write: if isSuperAdmin();
      }

      // ----------------------------------------------------------
      // Subcollection: Client Contracts, Rate Cards & Invoices (Module 1 & 2)
      // ----------------------------------------------------------
      match /contracts/{contractId} {
        allow read: if (sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("FINANCE") || isOfficialStaffDept("OPERATIONS")))
          || (isClientUserForCompany(cId) && resource.data.clientId == request.auth.token.clientId);
        allow write: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("FINANCE"));
      }

      match /rateCards/{rateCardId} {
        allow read: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("FINANCE") || isOfficialStaffDept("OPERATIONS"));
        allow write: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("FINANCE"));
      }

      match /clientInvoices/{invoiceId} {
        allow read: if (sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("FINANCE") || isOfficialStaffDept("OPERATIONS")))
          || (isClientUserForCompany(cId) && resource.data.clientId == request.auth.token.clientId);
        allow create, update: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("FINANCE"));
        allow delete: if sameCompany(cId) && isOwnerOrExecutive() && resource.data.status == "DRAFT";
      }

      match /slaBreaches/{breachId} {
        allow read: if (sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("FINANCE") || 
          isOfficialStaffDept("OPERATIONS") ||
          (authorityLevel() == "A5_SITE_IN_CHARGE" && resource.data.siteId == siteId())
        )) || (isClientUserForCompany(cId) && (resource.data.clientId == request.auth.token.clientId || clientHasSiteAccess(resource.data.siteId)));
        allow write: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("OPERATIONS") || isOfficialStaffDept("FINANCE"));
      }

      match /complianceDocuments/{docId} {
        allow read: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          isOfficialStaffDept("OPERATIONS") ||
          isSelfEmployee(resource.data.employeeId)
        );
        allow write: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
      }

      // ----------------------------------------------------------
      // Subcollection: Employee Management (HRMS)
      // ----------------------------------------------------------
      match /employees/{employeeId} {
        allow read: if sameCompany(cId) && (
          isOwnerOrExecutive() ||
          isOfficialStaffDept("HR") ||
          isOfficialStaffDept("FINANCE") ||
          (authorityLevel() == "A4_REGIONAL_AREA_MANAGER" && resource.data.assignedRegionId == regionId()) ||
          isSiteManager(resource.data.assignedSiteId, resource.data.departmentId) ||
          isSelfEmployee(resource.data.employeeId) ||
          isSelfUser(resource.data.userId)
        );

        allow create, delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));

        allow update: if sameCompany(cId) && (
          isOwnerOrExecutive() ||
          isOfficialStaffDept("HR") ||
          (isSiteManager(resource.data.assignedSiteId, resource.data.departmentId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorityLevel', 'companyId', 'salary', 'bankDetails']))
        );

        match /private_security/{docId} {
          allow read, write: if isSuperAdmin();
        }
        match /documents/{docId} {
          allow read: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR") || isSelfEmployee(employeeId));
          allow write: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
        }
        match /lifecycleEvents/{docId} {
          allow read: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR") || isSelfEmployee(employeeId));
          allow write: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
        }
      }

      match /role_assignments/{roleId} {
        allow read: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR") || isSelfEmployee(resource.data.employeeId));
        allow write: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
      }

      match /documents/{docId} {
        allow read: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR") || isSelfEmployee(resource.data.employeeId));
        allow write: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR") || isOfficialStaffDept("FINANCE") || isOfficialStaffDept("OPERATIONS"));
      }

      
      // Additional injected collections
      match /leaves/{itemId} {
        allow read: if sameCompany(cId);
        allow write: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR") || isSelfEmployee(resource.data.employeeId));
      }
      match /attendance_adjustments/{itemId} {
        allow read: if sameCompany(cId);
        allow write: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR") || isSiteManager(resource.data.siteId, resource.data.departmentId));
      }
      match /bank_payment_batches/{itemId} {
        allow read: if sameCompany(cId);
        allow write: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("FINANCE"));
      }
      match /performance_appraisals/{itemId} {
        allow read: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR") || isSiteManager(resource.data.siteId, resource.data.departmentId) || isSelfEmployee(resource.data.employeeId));
        allow write: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR") || isSiteManager(resource.data.siteId, resource.data.departmentId));
      }
      match /overtime_requests/{itemId} {
        allow read: if sameCompany(cId);
        allow write: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR") || isSiteManager(resource.data.siteId, resource.data.departmentId));
      }
      match /overtime_adjustments/{itemId} {
        allow read: if sameCompany(cId);
        allow write: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR") || isSiteManager(resource.data.siteId, resource.data.departmentId));
      }

      match /leave_requests/{leaveId} {
        allow read: if sameCompany(cId) && (
          isOwnerOrExecutive() ||
          isOfficialStaffDept("HR") ||
          isSiteManager(resource.data.siteId, resource.data.departmentId) ||
          isSelfEmployee(resource.data.employeeId)
        );
        allow create: if sameCompany(cId) && signedIn();
        allow update: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR") || isSiteManager(resource.data.siteId, resource.data.departmentId));
        allow delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
      }

      match /leave/{leaveId} {
        allow read: if sameCompany(cId) && (
          isOwnerOrExecutive() ||
          isOfficialStaffDept("HR") ||
          isSiteManager(resource.data.siteId, resource.data.departmentId) ||
          isSelfEmployee(resource.data.employeeId)
        );
        allow create: if sameCompany(cId) && signedIn();
        allow update: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR") || isSiteManager(resource.data.siteId, resource.data.departmentId));
        allow delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
      }

      // ----------------------------------------------------------
      // Subcollection: Attendance & Supervisor Muster Roll
      // ----------------------------------------------------------
      match /attendance_logs/{attendanceId} {
        allow read: if (sameCompany(cId) && (
          isOwnerOrExecutive() ||
          isOfficialStaffDept("HR") ||
          isOfficialStaffDept("FINANCE") ||
          isOfficialStaffDept("OPERATIONS") ||
          (authorityLevel() == "A4_REGIONAL_AREA_MANAGER" && (resource.data.assignedRegionId == regionId() || resource.data.assignedRegionId == null)) ||
          isSiteManager(resource.data.siteId, resource.data.departmentId) ||
          isSelfEmployee(resource.data.employeeId)
        )) || (isClientUserForCompany(cId) && clientHasSiteAccess(resource.data.siteId));

        // Supervisor Muster Creation: Actor (request.auth.token.sId) separates from Subject (request.resource.data.employeeId)
        // Strictly blocks unapproved OUTSIDE_GEOFENCE writes
        allow create: if sameCompany(cId) && (
          isOwnerOrExecutive() ||
          isOfficialStaffDept("HR") ||
          isOfficialStaffDept("OPERATIONS") ||
          (authorityLevel() in ["A5_SITE_IN_CHARGE", "A6_SUPERVISOR"] && request.resource.data.siteId == siteId() && !isSelfEmployee(request.resource.data.employeeId)) ||
          (
            isSelfEmployee(request.resource.data.employeeId) &&
            (
              !('checkInGps' in request.resource.data) ||
              request.resource.data.checkInGps == null ||
              !('verification' in request.resource.data.checkInGps) ||
              request.resource.data.checkInGps.verification != "OUTSIDE_GEOFENCE" ||
              (request.resource.data.checkInGps.geofenceOverrideRequested == true && request.resource.data.checkInGps.geofenceOverrideReason != null)
            )
          )
        );

        allow update: if sameCompany(cId) && (
          isOwnerOrExecutive() ||
          isOfficialStaffDept("HR") ||
          isOfficialStaffDept("OPERATIONS") ||
          isSiteManager(resource.data.siteId, resource.data.departmentId)
        );

        allow delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
      }

      match /attendance/{attendanceId} {
        allow read: if (sameCompany(cId) && (
          isOwnerOrExecutive() ||
          isOfficialStaffDept("HR") ||
          isOfficialStaffDept("FINANCE") ||
          isOfficialStaffDept("OPERATIONS") ||
          (authorityLevel() == "A4_REGIONAL_AREA_MANAGER" && (resource.data.assignedRegionId == regionId() || resource.data.assignedRegionId == null)) ||
          isSiteManager(resource.data.siteId, resource.data.departmentId) ||
          isSelfEmployee(resource.data.employeeId)
        )) || (isClientUserForCompany(cId) && clientHasSiteAccess(resource.data.siteId));

        // Blocks employee direct creation if location is flagged OUTSIDE_GEOFENCE without supervisor override
        allow create: if sameCompany(cId) && (
          isOwnerOrExecutive() ||
          isOfficialStaffDept("HR") ||
          isOfficialStaffDept("OPERATIONS") ||
          (authorityLevel() in ["A5_SITE_IN_CHARGE", "A6_SUPERVISOR"] && request.resource.data.siteId == siteId() && !isSelfEmployee(request.resource.data.employeeId)) ||
          (
            isSelfEmployee(request.resource.data.employeeId) &&
            (
              !('checkInGps' in request.resource.data) ||
              request.resource.data.checkInGps == null ||
              !('verification' in request.resource.data.checkInGps) ||
              request.resource.data.checkInGps.verification != "OUTSIDE_GEOFENCE" ||
              (request.resource.data.checkInGps.geofenceOverrideRequested == true && request.resource.data.checkInGps.geofenceOverrideReason != null)
            )
          )
        );

        allow update: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          isOfficialStaffDept("OPERATIONS") || 
          (isSiteManager(resource.data.siteId, resource.data.departmentId) && request.resource.data.siteId == resource.data.siteId) ||
          (
            isSelfEmployee(resource.data.employeeId) &&
            request.resource.data.employeeId == resource.data.employeeId &&
            request.resource.data.siteId == resource.data.siteId &&
            request.resource.data.checkInTime == resource.data.checkInTime &&
            (
              !('checkOutGps' in request.resource.data) ||
              request.resource.data.checkOutGps == null ||
              !('verification' in request.resource.data.checkOutGps) ||
              request.resource.data.checkOutGps.verification != "OUTSIDE_GEOFENCE" ||
              (request.resource.data.checkOutGps.geofenceOverrideRequested == true && request.resource.data.checkOutGps.geofenceOverrideReason != null)
            )
          )
        );
        allow delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
      }

