rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // DEFAULT: DENY EVERYTHING (ZERO-TRUST SECURITY BY DEFAULT)
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ============================================================
    // REUSABLE SECURITY GATES & HELPERS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Multi-tenant safe verification: Check if user is a member of the company tenant
    function hasMembership(companyId) {
      return signedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(companyId))
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userData().companyId == companyId)
      );
    }

    function getMembership(companyId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(companyId)).data;
    }

    // Role-based verification nested inside tenant isolation boundaries
    function hasCompanyRole(companyId, rolesList) {
      return signedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(companyId)) && 
         getMembership(companyId).role in rolesList)
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
            userData().companyId == companyId && 
            userData().role in rolesList)
      );
    }

    function sameCompany(companyId) {
      return signedIn() && hasMembership(companyId);
    }

    function isSuperAdmin() {
      return signedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         userData().role == "SUPER_ADMIN")
        || hasCompanyRole("GLOBAL_ADMIN", ["SUPER_ADMIN"])
      );
    }

    function isCompanyAdmin(companyId) {
      return isSuperAdmin() || hasCompanyRole(companyId, ["COMPANY_ADMIN", "ADMIN", "HR_ADMIN", "super_admin", "admin", "hr_admin", "OWNER_PROMOTER", "DIRECTOR_CEO", "GENERAL_MANAGER"]);
    }

    function isManager(companyId) {
      return isSuperAdmin() || hasCompanyRole(companyId, [
        "COMPANY_ADMIN", "ADMIN", "HR_ADMIN", "OPS_MANAGER", "FIELD_OFFICER", "MANAGER", "SUPERVISOR", "OWNER_PROMOTER", "DIRECTOR_CEO", "GENERAL_MANAGER", "REGIONAL_MANAGER", "AREA_MANAGER", "SITE_IN_CHARGE", "HR", "FINANCE", "PROCUREMENT", "EHS", "QUALITY", "COMMERCIAL", "MIS", "CLIENT_MANAGEMENT", "IT", "OPERATIONS_OFFICE",
        "super_admin", "admin", "hr_admin", "ops_manager", "field_officer", "manager", "supervisor"
      ]);
    }

    function canViewSalary(companyId) {
      return isSuperAdmin() || hasCompanyRole(companyId, ["COMPANY_ADMIN", "ADMIN", "HR_ADMIN", "HR", "FINANCE", "OWNER_PROMOTER", "DIRECTOR_CEO", "GENERAL_MANAGER", "COMMERCIAL", "CLIENT_MANAGEMENT"]);
    }

    function canViewEmployeeIdentity(companyId) {
      return isSuperAdmin() || hasCompanyRole(companyId, ["COMPANY_ADMIN", "ADMIN", "HR_ADMIN", "HR", "OWNER_PROMOTER", "DIRECTOR_CEO", "GENERAL_MANAGER"]);
    }


    // ============================================================
    // VALIDATION BLUEPRINTS (Payload-First Security)
    // ============================================================

    function isValidTask() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'companyId', 'siteId', 'assignedTo', 'title', 'status', 'createdAt'])
        && data.id is string
        && data.companyId is string
        && data.status in ['TODO', 'IN_PROGRESS', 'PENDING_VERIFICATION', 'COMPLETED', 'CANCELLED'];
    }

    function isValidIncidentReport() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'companyId', 'siteId', 'status'])
        && data.id is string
        && data.companyId is string;
    }

    function isValidPatrolPlan() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'companyId', 'siteId', 'planName', 'status'])
        && data.id is string
        && data.companyId is string;
    }

    function isValidPatrolTour() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'companyId', 'siteId', 'status'])
        && data.id is string
        && data.companyId is string;
    }

    function isValidPatrolCheckpoint() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'companyId', 'siteId', 'checkpointName', 'code', 'status'])
        && data.id is string
        && data.companyId is string;
    }

    function isValidPatrolLog() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'companyId', 'siteId', 'guardId', 'status'])
        && data.id is string
        && data.companyId is string;
    }

    function isValidDailySiteLog() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'companyId', 'logType', 'siteId', 'date', 'status', 'createdAt'])
        && data.logType in ['INSPECTION', 'HANDOVER', 'DAILY_REPORT']
        && data.status in ['DRAFT', 'SUBMITTED', 'REVIEWED', 'ACCEPTED', 'INITIATED'];
    }

    function isValidVisitorLog() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'companyId', 'siteId', 'visitorName', 'status', 'createdAt'])
        && data.status in ['IN_SITE', 'CHECKED_OUT'];
    }

    function isValidMaterialMovement() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'companyId', 'siteId', 'movementType', 'gatePassNumber', 'status', 'createdAt'])
        && data.movementType in ['INWARD', 'OUTWARD']
        && data.status in ['PENDING_APPROVAL', 'APPROVED', 'DISPATCHED', 'RECEIVED', 'REJECTED'];
    }

    function isValidLead() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'name', 'company', 'email', 'phone', 'status', 'createdAt'])
        && data.id is string
        && data.status in ['NEW', 'CONTACTED', 'QUALIFIED', 'DEMO', 'CONVERTED', 'LOST'];
    }

    function isValidAnnouncement() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'companyId', 'message', 'priority', 'createdAt'])
        && data.priority in ['NORMAL', 'URGENT'];
    }

    function isValidKpiSnapshot() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'companyId', 'date', 'status', 'createdAt'])
        && data.status == 'PUBLISHED';
    }

    function isValidAuditLog() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'action', 'actorId', 'timestamp'])
        && data.id is string
        && data.action is string;
    }

    // ============================================================
    // LEADS (Root Level Collection)
    // ============================================================
    match /leads/{leadId} {
      allow read, update, delete: if isSuperAdmin();
      allow create: if isValidLead();
    }

    // ============================================================
    // USERS (Root Level Collection)
    // ============================================================

    match /users/{uid} {
      // Users can access their own document, super admins can access any, and company members can read profiles in the same tenant
      allow read: if isSelf(uid) 
        || isSuperAdmin() 
        || (signedIn() && (
             (resource.data != null && hasMembership(resource.data.companyId)) ||
             (resource.data != null && hasMembership(resource.data.default_company_id))
           ));

      // User creation is allowed for self (during sign up) or by authorized company managers
      allow create: if isSuperAdmin()
        || (signedIn() && (
             isSelf(uid) || 
             (request.resource.data != null && isManager(request.resource.data.companyId)) ||
             (request.resource.data != null && isManager(request.resource.data.default_company_id))
           ));

      // Updates are partitioned strictly to prevent self-promotion or cross-tenant hijacking
      allow update: if isSuperAdmin()
        || (signedIn() && (
             (resource.data != null && isManager(resource.data.companyId)) ||
             (isSelf(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'companyId']))
           ));

      allow delete: if isSuperAdmin();

      // ----------------------------------------------------------
      // SUB-COLLECTION: MEMBERSHIPS
      // ----------------------------------------------------------
      match /memberships/{companyId} {
        allow read: if isSuperAdmin() || isSelf(uid) || isCompanyAdmin(companyId);
        allow create, update, delete: if isSuperAdmin() || isCompanyAdmin(companyId);
      }
    }


    // ============================================================
    // COMPANIES (Hierarchical Multi-Tenant Framework)
    // ============================================================

    match /companies/{companyId} {

      // GRC: Security Audit & Anomaly Detection
      match /security_events/{eventId} {
        allow read: if isSuperAdmin() || isCompanyAdmin(companyId);
        allow create: if signedIn() && (isSuperAdmin() || sameCompany(companyId)) 
                      && request.resource.data.companyId == companyId
                      && request.resource.data.userId == request.auth.uid; // Must use own userId
        // Backend can forge userId if needed, but from client must match. Wait, what about failed login? Failed login might not have auth.uid yet if not signed in, but we can't secure that easily on client.
        // Let's allow create if signedIn and sameCompany, or if SuperAdmin.
        allow update, delete: if false; // Append-only immutable audit log
      }

      match /security_anomalies/{anomalyId} {
        allow read: if isSuperAdmin() || isCompanyAdmin(companyId);
        // Only backend should ideally create anomalies, or if client creates them, they can't delete them.
        allow create: if signedIn() && (isSuperAdmin() || sameCompany(companyId));
        allow update: if signedIn() && (isSuperAdmin() || isCompanyAdmin(companyId));
        allow delete: if false;
      }
      // Individual company lookup allowed to let unauthenticated users verify codes
      allow get: if true;
      allow list: if isSuperAdmin() || sameCompany(companyId);

      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || isCompanyAdmin(companyId);
      allow delete: if isSuperAdmin();

      // ==========================================
      // PHASE 2: SUBSCRIPTION & ENTITLEMENT SYSTEM
      // ==========================================
      match /subscriptions/{subscriptionId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin(); // Only Super Admin or Webhook backend can update subscriptions
      }
      match /entitlements/{moduleId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin(); // Only Super Admin or Webhook backend can update entitlements
      }
      match /payments/{paymentId} {
        allow read: if isSuperAdmin() || isCompanyAdmin(companyId);
        allow write: if false; // Payments are created by secure backend webhook only
      }
      match /invoices/{invoiceId} {
        allow read: if isSuperAdmin() || isCompanyAdmin(companyId);
        allow write: if false; // Invoices generated by backend
      }
      match /subscriptionHistory/{historyId} {
        allow read: if isSuperAdmin() || isCompanyAdmin(companyId);
        allow write: if false; // Immutable history written by backend
      }


      
      // ==========================================
      // MODULE 13.3: MANDATORY REFRESHERS SYSTEM
      // ==========================================
      match /mandatory_refreshers_config/{configId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isCompanyAdmin(companyId);
      }
      match /employee_refresher_status/{statusId} {
        // Employees can read their own or others in same company for compliance directory
        allow read: if isSuperAdmin() || sameCompany(companyId);
        // Only HR/Admin or secure backend can update
        allow write: if isSuperAdmin() || isCompanyAdmin(companyId) || isManager(companyId);
      }
      match /refresher_enrollments/{enrollmentId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isCompanyAdmin(companyId) || isManager(companyId);
      }

      
      
      // ==========================================
      // MODULE 14.2: RFQ MANAGEMENT SYSTEM
      // ==========================================
      match /rfq_requests/{rfqId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow create, update: if isSuperAdmin() || isCompanyAdmin(companyId) || isManager(companyId);
        allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
      }
      match /rfq_bids/{bidId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow create, update: if isSuperAdmin() || isCompanyAdmin(companyId) || isManager(companyId);
        allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
      }
      match /rfq_evaluation_logs/{logId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isCompanyAdmin(companyId) || isManager(companyId);
      }

      
      // ==========================================
      // MODULE 14.3: PURCHASE ORDERS
      // ==========================================
      match /purchase_orders/{poId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow create, update: if isSuperAdmin() || isCompanyAdmin(companyId) || isManager(companyId);
        allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
      }
      match /po_amendments/{amendmentId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isCompanyAdmin(companyId) || isManager(companyId);
      }

      
      // ==========================================
      // MODULE 14.4: 3-WAY MATCHING
      // ==========================================
      match /vendor_invoices/{invoiceId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow create, update: if isSuperAdmin() || isCompanyAdmin(companyId) || isManager(companyId) || hasRole(companyId, 'A3_SUPERVISOR_MANAGER');
      }
      match /three_way_match_records/{matchId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if false; // System only (Cloud Functions)
      }

      // ==========================================
      // MODULE 14.1: VENDOR MANAGEMENT SYSTEM
      // ==========================================
      match /srm_vendors/{vendorId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow create, update: if isSuperAdmin() || isCompanyAdmin(companyId) || isManager(companyId);
        allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
      }
      match /vendor_documents/{docId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow create, update: if isSuperAdmin() || isCompanyAdmin(companyId) || isManager(companyId);
        allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
      }
      match /vendor_performance_logs/{logId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isCompanyAdmin(companyId) || isManager(companyId);
      }

      // 1. HRMS Subcollections (Employees, Role Assignments, Documents, Leaves)
      match /employees/{employeeId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow create: if isSuperAdmin() || isCompanyAdmin(companyId);
        allow update: if isSuperAdmin() || isManager(companyId) || (signedIn() && sameCompany(companyId) && employeeId == userData().employeeId);
        allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
      }

      match /role_assignments/{roleId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isCompanyAdmin(companyId);
      }

      match /employee_documents/{docId} {
        allow read: if canViewEmployeeIdentity(companyId) || (signedIn() && sameCompany(companyId) && resource.data.employeeId == userData().employeeId);
        allow create, update: if isSuperAdmin() || isManager(companyId) || (signedIn() && sameCompany(companyId) && request.resource.data.employeeId == userData().employeeId);
        allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
      }

      match /document_types/{typeId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isCompanyAdmin(companyId);
      }

      match /document_history/{historyId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow create: if isSuperAdmin() || isManager(companyId);
        allow update, delete: if false;
      }

      match /leave/{leaveId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow create: if isSuperAdmin() || sameCompany(companyId);
        allow update: if isSuperAdmin() || isManager(companyId);
        allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
      }

      match /leave_requests/{leaveId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow create: if isSuperAdmin() || sameCompany(companyId);
        allow update: if isSuperAdmin() || isManager(companyId);
        allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
      }


      // 2. Attendance & Muster Roll Subcollections
      match /attendance/{attendanceId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow create: if isSuperAdmin() || sameCompany(companyId);
        allow update: if isSuperAdmin() || isManager(companyId);
        allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
      }

      match /overtime_policies/{policyId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isCompanyAdmin(companyId);
      }

      match /overtime_requests/{requestId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow create: if isSuperAdmin() || sameCompany(companyId);
        allow update: if isSuperAdmin() || isManager(companyId);
        allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
      }

      match /overtime_adjustments/{adjustmentId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow create: if isSuperAdmin() || isManager(companyId);
        allow update: if isSuperAdmin() || isManager(companyId);
        allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
      }

      match /attendance_exceptions/{exceptionId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isManager(companyId);
      }

      match /attendance_logs/{attendanceId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow create: if isSuperAdmin() || sameCompany(companyId);
        allow update: if isSuperAdmin() || isManager(companyId);
        allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
      }

      match /attendance_summaries/{summaryId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isManager(companyId);
      }

      match /site_muster_rolls/{rollId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isManager(companyId);
      }

      match /attendance_devices/{deviceId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isCompanyAdmin(companyId);
      }


      // 3. Payroll, Compensation & Advances Subcollections
      
      // Module 10: Security Assurance & Release Gate
      
      // Module 10: Continuous Security Monitoring
      match /security_detection_rules/{ruleId} {
        allow read: if isCompanyMember();
        allow write: if hasRole('SUPER_ADMIN') || hasRole('SYSTEM');
      }
      
      match /detected_risk_events/{eventId} {
        allow read: if isCompanyMember();
        allow write: if hasRole('SUPER_ADMIN') || hasRole('COMPANY_ADMIN') || hasRole('SYSTEM');
      }

      match /security_assurance_runs/{runId} {
        allow read: if isCompanyMember();
        allow write: if hasRole('SUPER_ADMIN') || hasRole('SYSTEM') || hasRole('HR_ADMIN');
      }
      
      match /security_findings/{findingId} {
        allow read: if isCompanyMember();
        allow write: if hasRole('SUPER_ADMIN') || hasRole('COMPANY_ADMIN') || hasRole('HR_ADMIN') || hasRole('SYSTEM');
      }
      
      match /production_signoffs/{signoffId} {
        allow read: if isCompanyMember();
        allow write: if hasRole('SUPER_ADMIN');
      }

      match /payroll/{payrollId} {
        allow read: if isSuperAdmin() || isCompanyAdmin(companyId);
        allow create, update: if isSuperAdmin() || isCompanyAdmin(companyId);
        allow delete: if isSuperAdmin();
      }

      match /payroll_cycles/{cycleId} {
        allow read: if isSuperAdmin() || isCompanyAdmin(companyId);
        allow write: if isSuperAdmin() || isCompanyAdmin(companyId);
      }

      match /payroll_profiles/{payrollId} {
        allow read: if isSuperAdmin() || isCompanyAdmin(companyId);
        allow write: if isSuperAdmin() || isCompanyAdmin(companyId);
      }

      match /employee_salary_profiles/{profileId} {
        allow read: if canViewSalary(companyId) || (signedIn() && sameCompany(companyId) && resource.data.employeeId == userData().employeeId);
        allow write: if isSuperAdmin() || isCompanyAdmin(companyId) || canViewSalary(companyId);
      }

      match /salary_structures/{structureId} {
        allow read: if isSuperAdmin() || isCompanyAdmin(companyId) || canViewSalary(companyId);
        allow write: if isSuperAdmin() || isCompanyAdmin(companyId);
      }

      match /salary_slips/{slipId} {
        allow read: if canViewSalary(companyId) || (signedIn() && sameCompany(companyId) && resource.data.employeeId == userData().employeeId);
        allow write: if isSuperAdmin() || isCompanyAdmin(companyId) || canViewSalary(companyId);
      }

      match /salary_advances/{advanceId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isCompanyAdmin(companyId) || (signedIn() && sameCompany(companyId));
      }

      match /advances_and_deductions/{advanceId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isCompanyAdmin(companyId);
      }

      match /bank_payment_batches/{batchId} {
        allow read: if isSuperAdmin() || isCompanyAdmin(companyId);
        allow create, update: if isSuperAdmin() || isCompanyAdmin(companyId);
        allow delete: if isSuperAdmin();
      }

      match /company_bank_accounts/{accountId} {
        allow read: if isSuperAdmin() || isCompanyAdmin(companyId);
        allow write: if isSuperAdmin() || isCompanyAdmin(companyId);
      }


      // 4. Inventory, Supply & Stock Subcollections
      match /inventory/{inventoryId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow create, update: if isSuperAdmin() || isManager(companyId);
        allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
      }

      match /inventory_items/{itemId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || sameCompany(companyId);
      }
      match /stock_locations/{locId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isManager(companyId) || isCompanyAdmin(companyId);
      }
      match /stock_balances/{balId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || sameCompany(companyId); // Backend logic handles validation
      }
      match /stock_ledger/{ledgerId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || sameCompany(companyId);
      }
      match /gate_passes/{passId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || sameCompany(companyId);
      }
      match /inventory_alerts/{alertId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || sameCompany(companyId);
      }
      match /transfer_orders/{trId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || sameCompany(companyId);
      }


      match /site_inventory/{inventoryId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isManager(companyId);
      }

      match /inventory_transactions/{transactionId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isManager(companyId);
      }


      // 5. Assets, Suppliers, Vendors, Clients, Billing
      match /assets/{assetId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isManager(companyId);
      }

      match /maintenance_plans/{planId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isManager(companyId);
      }

      match /maintenance_occurrences/{occurrenceId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isManager(companyId);
      }

      match /warranties/{warrantyId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isManager(companyId) || sameCompany(companyId);
      }

      match /warranty_claims/{claimId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isManager(companyId) || sameCompany(companyId);
      }

      match /vendors/{vendorId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isManager(companyId);
      }

      match /clients/{clientId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isManager(companyId);
      }

      match /contracts/{contractId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isManager(companyId);
      }

      match /billing/{billingId} {
        allow read: if isSuperAdmin() || isCompanyAdmin(companyId);
        allow create, update: if isSuperAdmin() || isCompanyAdmin(companyId);
        allow delete: if isSuperAdmin();
      }

      

      


      // 6. Site Operations Logs, Safety, Incident & Visitors
      match /patrol_plans/{planId} {
