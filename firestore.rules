      match /compliance_obligations/{docId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow create, update: if isSuperAdmin() || (sameCompany(companyId) && (isCompanyAdmin(companyId) || request.auth.token.role == "HR_ADMIN"));
        allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
      }
      match /obligation_reviews/{docId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow create, update: if isSuperAdmin() || sameCompany(companyId);
        allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
      }

      match /bpm_threshold_rules/{ruleId} {
        allow read: if isSuperAdmin() || sameCompany(companyId);
        allow write: if isSuperAdmin() || isCompanyAdmin(companyId);
      }
    }


    // ============================================================
    // DYNAMIC COMPANY ATTENDANCE COLLECTIONS
    // (e.g., /attendance_MUSTER-CORP-101)
    // ============================================================

    match /{collectionId}/{attendanceId} {
      
      function isAttendanceCollection() {
        return collectionId.startsWith("attendance_");
      }

      // Extracts company code securely using splits
      function getCompanyCodeFromCollection() {
        return collectionId.split("attendance_")[1];
      }

      allow read: if isAttendanceCollection() && (
        isSuperAdmin() || sameCompany(getCompanyCodeFromCollection())
      );

      allow create: if isAttendanceCollection() && (
        isSuperAdmin() || sameCompany(getCompanyCodeFromCollection())
      );

      allow update: if isAttendanceCollection() && (
        isSuperAdmin() || isManager(getCompanyCodeFromCollection())
      );

      allow delete: if isAttendanceCollection() && (
        isSuperAdmin() || isCompanyAdmin(getCompanyCodeFromCollection())
      );
    }


    // ============================================================
    // GLOBAL TOP-LEVEL COLLECTIONS
    // ============================================================



    match /system_audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if signedIn() && isValidAuditLog();
      allow update, delete: if false;
    }



    match /plans/{planId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /modules/{moduleId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /company_codes/{codeId} {
      allow read: if true; // Public lookup to verify company codes
      allow write: if isSuperAdmin();
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }
  }
}
