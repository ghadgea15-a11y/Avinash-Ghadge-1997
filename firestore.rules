          allow create: if (sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR") || authorityLevel() in ["A4_REGIONAL_AREA_MANAGER", "A5_SITE_IN_CHARGE", "A6_SUPERVISOR"])) ||
                           (signedIn() && request.resource.data.companyId == cId);
