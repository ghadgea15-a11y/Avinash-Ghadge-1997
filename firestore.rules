          isSiteManager(resource.data.siteId, resource.data.departmentId) ||
          isSelfEmployee(resource.data.employeeId)
        );
        allow create, update: if sameCompany(cId) && (
          isOwnerOrExecutive() || 
          isOfficialStaffDept("HR") || 
          isSiteManager(request.resource.data.siteId, request.resource.data.departmentId) ||
          isSiteManager(resource.data.siteId, resource.data.departmentId)
        );
        allow delete: if sameCompany(cId) && (isOwnerOrExecutive() || isOfficialStaffDept("HR"));
